# ========================================
# 🚀 NEUROTASK - AI AGENTS FOR BUSINESS
# 📁 Development Environment Configuration
# ========================================

# ========================================
# 🌍 Основные настройки
# ========================================
NODE_ENV=development
PORT=3001
HOST=localhost

# ========================================
# 🗄️ База данных MongoDB
# ========================================
MONGODB_URI=mongodb://localhost:27017/neurotask_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# ========================================
# 🔴 Redis кэш
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CLIENTS=50
REDIS_RETRY_STRATEGY=1000

# ========================================
# 🔐 Сессии и безопасность
# ========================================
SESSION_SECRET=your-development-secret-key-change-in-production
SESSION_MAX_AGE=86400000
SESSION_NAME=neurotask_sid
CSRF_SECRET=your-csrf-secret-key-change-in-production

# ========================================
# 🔑 API ключи для межсервисного взаимодействия
# ========================================
DATABASE_SERVICE_API_KEY=database-service-dev-key-2024
CACHE_SERVICE_API_KEY=cache-service-dev-key-2024
BALANCE_SERVICE_API_KEY=balance-service-dev-key-2024
TELEGRAM_BOT_SERVICE_API_KEY=telegram-bot-dev-key-2024
AI_GATEWAY_SERVICE_API_KEY=ai-gateway-dev-key-2024

# ========================================
# 🤖 AI провайдеры
# ========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORGANIZATION=your-openai-org-id
OPENAI_MODEL=gpt-4-turbo-preview

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro

ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

XAI_API_KEY=your-xai-api-key-here
XAI_MODEL=grok-beta

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

GIGACHAT_API_KEY=your-gigachat-api-key-here
GIGACHAT_MODEL=GigaChat:latest

YANDEXGPT_API_KEY=your-yandexgpt-api-key-here
YANDEXGPT_MODEL=yandexgpt-lite

# ========================================
# 📱 Telegram Bot
# ========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ========================================
# 📅 Google Calendar
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar

# ========================================
# 📧 Email (опционально)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# ========================================
# 🔒 CORS и безопасность
# ========================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# ========================================
# 📊 Логирование
# ========================================
LOG_LEVEL=debug
LOG_FORMAT=dev
LOG_FILE=logs/development.log

# ========================================
# 🧪 Тестирование
# ========================================
TEST_MONGODB_URI=mongodb://localhost:27017/neurotask_test
TEST_REDIS_URL=redis://localhost:6379/1
JEST_TIMEOUT=30000

# ========================================
# 🔧 Дополнительные настройки
# ========================================
ENABLE_SWAGGER=true
ENABLE_GRAPHIQL=true
ENABLE_DEBUG_MODE=true
ENABLE_HOT_RELOAD=true

# ========================================
# 📱 Мобильные настройки
# ========================================
MOBILE_APP_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false

# ========================================
# 🌐 Интернационализация
# ========================================
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en
