# ========================================
# 🚀 NEUROTASK - AI AGENTS FOR BUSINESS
# 📁 Production Environment Configuration
# ========================================

# ========================================
# 🌍 Основные настройки
# ========================================
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# ========================================
# 🗄️ База данных MongoDB
# ========================================
MONGODB_URI=mongodb://username:password@mongodb-host:27017/neurotask_prod
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=30000
MONGODB_SOCKET_TIMEOUT_MS=30000

# ========================================
# 🔴 Redis кэш
# ========================================
REDIS_URL=redis://:password@redis-host:6379
REDIS_MAX_CLIENTS=100
REDIS_RETRY_DELAY=200
REDIS_MAX_ATTEMPTS=10

# ========================================
# 🔐 Сессии и безопасность
# ========================================
SESSION_SECRET=your-production-secret-key-change-immediately
SESSION_MAX_AGE=86400000
SESSION_NAME=neurotask_sid
CSRF_SECRET=your-production-csrf-secret-key
BCRYPT_ROUNDS=12

# ========================================
# 🔑 API ключи для межсервисного взаимодействия
# ========================================
DATABASE_SERVICE_API_KEY=neurotask-database-service-prod-key-2024
CACHE_SERVICE_API_KEY=neurotask-cache-service-prod-key-2024
BALANCE_SERVICE_API_KEY=neurotask-balance-service-prod-key-2024
TELEGRAM_BOT_SERVICE_API_KEY=neurotask-telegram-bot-service-prod-key-2024
AI_GATEWAY_SERVICE_API_KEY=neurotask-ai-gateway-service-prod-key-2024

# ========================================
# 🤖 AI провайдеры
# ========================================
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
XAI_API_KEY=your-xai-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_SERVICE_URL=http://localhost:3004 # Placeholder - Replace with your actual DeepSeek service URL
GIGACHAT_API_KEY=your-gigachat-api-key-here
YANDEXGPT_API_KEY=your-yandexgpt-api-key-here

# ========================================
# 📱 Telegram Bot
# ========================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# ========================================
# 📅 Google Calendar
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# ========================================
# 📧 Email
# ========================================
EMAIL_HOST=smtp.your-domain.com
EMAIL_PORT=587
EMAIL_USER=your-email@your-domain.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@your-domain.com
EMAIL_SECURE=true

# ========================================
# 🌐 CORS и домены
# ========================================
CORS_ORIGIN=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ========================================
# 📊 Логирование и мониторинг
# ========================================
LOG_LEVEL=info
LOG_FORMAT=json
SENTRY_DSN=your-sentry-dsn-here
PROMETHEUS_PORT=9090

# ========================================
# 🔒 Безопасность
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true
CSP_ENABLED=true

# ========================================
# 🧪 Тестирование
# ========================================
TEST_MONGODB_URI=mongodb://username:password@mongodb-host:27017/neurotask_test
TEST_REDIS_URL=redis://:password@redis-host:6379/1
JEST_TIMEOUT=30000

# ========================================
# 🚀 Производительность
# ========================================
CLUSTER_ENABLED=true
CLUSTER_WORKERS=4
COMPRESSION_ENABLED=true
CACHE_CONTROL_MAX_AGE=86400

# ========================================
# 📱 Push уведомления
# ========================================
PUSH_NOTIFICATIONS_ENABLED=true
FCM_SERVER_KEY=your-fcm-server-key-here

# ========================================
# 💳 Платежи
# ========================================
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here

# ========================================
# 🔍 Аналитика
# ========================================
GOOGLE_ANALYTICS_ID=your-ga-id-here
MIXPANEL_TOKEN=your-mixpanel-token-here
AMPLITUDE_API_KEY=your-amplitude-api-key-here

# ========================================
# 📊 Мониторинг производительности
# ========================================
