DATADOG_API_KEY=your-datadog-api-key-here
DATADOG_APP_KEY=your-datadog-app-key-here

# ========================================
# 🌍 CDN и статические файлы
# ========================================
CDN_URL=https://cdn.your-domain.com
S3_BUCKET=your-s3-bucket-name
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_REGION=us-east-1

# ========================================
# 🔐 SSL и сертификаты
# ========================================
SSL_ENABLED=true
SSL_KEY_PATH=/path/to/private-key.pem
SSL_CERT_PATH=/path/to/certificate.pem
LETSENCRYPT_ENABLED=true

# ========================================
# 📱 Мобильные приложения
# ========================================
MOBILE_APP_ENABLED=true
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apns-team-id
APNS_BUNDLE_ID=com.yourcompany.neurotask

# ========================================
# 🌐 Интернационализация
# ========================================
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en,de,fr,es
I18N_FALLBACK_LOCALE=en

# ========================================
# 🔄 Автоматические обновления
# ========================================
AUTO_UPDATE_ENABLED=true
UPDATE_CHECK_INTERVAL=3600000
UPDATE_NOTIFICATION_ENABLED=true

# ========================================
# 📊 Резервное копирование
# ========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket-name

# ========================================
# 🚨 Алерты и уведомления
# ========================================
ALERT_EMAIL=alerts@your-domain.com
SLACK_WEBHOOK_URL=your-slack-webhook-url
TELEGRAM_ALERT_CHAT_ID=your-telegram-chat-id

# ========================================
# 🔍 Поиск
# ========================================
ELASTICSEARCH_URL=http://elasticsearch-host:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password

# ========================================
# 📈 Метрики и дашборды
# ========================================
GRAFANA_URL=http://grafana-host:3000
GRAFANA_API_KEY=your-grafana-api-key
PROMETHEUS_URL=http://prometheus-host:9090

# ========================================
# 🐳 Docker и контейнеризация
# ========================================
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=neurotask

# ========================================
# 🔄 CI/CD
# ========================================
GITLAB_URL=https://gitlab.your-domain.com
GITLAB_TOKEN=your-gitlab-token
DEPLOYMENT_ENVIRONMENT=production
ROLLBACK_ENABLED=true

# ========================================
# 📱 Webhook и интеграции
# ========================================
WEBHOOK_SECRET=your-webhook-secret-here
ZAPIER_WEBHOOK_URL=your-zapier-webhook-url
IFTTT_WEBHOOK_URL=your-ifttt-webhook-url

# ========================================
# 🔐 Двухфакторная аутентификация
# ========================================
TOTP_ENABLED=true
TOTP_ISSUER=Neurotask
TOTP_ALGORITHM=SHA1
TOTP_DIGITS=6
TOTP_PERIOD=30

# ========================================
# 📊 Аудит и логирование
# ========================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
USER_ACTIVITY_TRACKING=true
SENSITIVE_DATA_MASKING=true

# ========================================
# 🌍 Геолокация и локализация
# ========================================
GEOIP_ENABLED=true
GEOIP_DATABASE_PATH=/path/to/geoip-database.mmdb
TIMEZONE_DETECTION=true
DEFAULT_TIMEZONE=Europe/Moscow

# ========================================
# 🔒 Шифрование данных
# ========================================
ENCRYPTION_KEY=your-encryption-key-here
ENCRYPTION_ALGORITHM=AES-256-GCM
SENSITIVE_FIELDS_ENCRYPTION=true

# ========================================
# 📱 Push-уведомления для браузера
# ========================================
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
PUSH_SUBSCRIPTION_ENABLED=true

# ========================================
# 🔍 Поиск по содержимому
# ========================================
FULL_TEXT_SEARCH_ENABLED=true
SEARCH_INDEX_REBUILD_INTERVAL=86400000
SEARCH_RESULTS_LIMIT=100

# ========================================
# 📊 Экспорт данных
# ========================================
DATA_EXPORT_ENABLED=true
EXPORT_FORMATS=json,csv,xlsx,pdf
EXPORT_MAX_RECORDS=10000
EXPORT_RETENTION_DAYS=7

# ========================================
