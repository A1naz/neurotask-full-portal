# Frontend variables (accessible in Vite with import.meta.env)
VITE_API_BASE=http://localhost:3001
VITE_APP_BASE_URL=https://neurotask.ru

# Main Server variables
PORT=3001
NODE_ENV=development

# Session Configuration
SESSION_SECRET=your-super-secret-key-change-this-in-production

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://neurotask.ru

# Database Configuration (для будущего использования)
# MONGODB_URI=mongodb://localhost:27017/telegram_calendar
# DATABASE_NAME=telegram_calendar

# JWT Configuration (для будущего использования)
# JWT_SECRET=your-jwt-secret-key
# JWT_EXPIRES_IN=24h 