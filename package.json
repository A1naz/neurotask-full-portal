{
  "name": "neurotask-ai-agents",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "migrate": "node server/run-migration.js",
    "setup-api-keys": "node server/setup-global-api-keys.js",
    "verify-migration": "node server/verify-migration.js",
    "start:main": "cd server && npm start",
    "start:balance": "cd balance-service && npm start",
    "start:telegram": "cd telegram-bot-service && npm start",
    "start:ai-gateway": "cd ai-gateway-service && npm start",
    "start:openai": "cd openai-service && npm start",
    "start:gemini": "cd gemini-service && npm start",
    "start:anthropic": "cd anthropic-service && npm start",
    "start:xai": "cd xai-service && npm start",
    "start:deepseek": "cd deepseek-service && npm start",
    "start:gigachat": "cd gigachat-service && npm start",
    "start:yandexgpt": "cd yandexgpt-service && npm start",
    "start:database": "cd database-service && npm start",
    "start:cache": "cd cache-service && npm start",
    "start:all": "concurrently \"npm run start:database\" \"npm run start:cache\" \"npm run start:main\" \"npm run start:balance\" \"npm run start:telegram\" \"npm run start:ai-gateway\" \"npm run start:openai\" \"npm run start:gemini\" \"npm run start:anthropic\" \"npm run start:xai\" \"npm run start:deepseek\" \"npm run start:gigachat\" \"npm run start:yandexgpt\" \"npm run dev\"",
    "install:all": "npm install && cd server && npm install && cd ../database-service && npm install && cd ../cache-service && npm install && cd ../balance-service && npm install && cd ../telegram-bot-service && npm install && cd ../ai-gateway-service && npm install && cd ../openai-service && npm install && cd ../gemini-service && npm install && cd ../anthropic-service && npm install && cd ../xai-service && npm install && cd ../deepseek-service && npm install && cd ../gigachat-service && npm install && cd ../yandexgpt-service && npm install"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "lucide-react": "^0.263.1",
    "mongoose": "^6.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "recharts": "^3.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5"
  }
}
